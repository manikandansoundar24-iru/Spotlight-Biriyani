// Spot Light Biriyani — Cloud PostgreSQL Schema (Free Tier Neon / Supabase)
// No local database installation required on laptop.
// Direct serverless connection via standard PostgreSQL URI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id              String         @id
  name            String
  address         String
  phone           String
  dailyBatchCap   Int            @default(160)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sales           Sale[]
  stockMoves      StockMove[]
  kitchenBatches  KitchenBatch[]
}

model Channel {
  id              String   @id // counter | swiggy | zomato
  name            String
  commissionPct   Float    @default(0.0)
  packagingCost   Float    @default(0.0)
}

model DishItem {
  id          String     @id @default(cuid())
  name        String
  category    String     // biryani | kushka | starter | etc.
  price       Float      // Counter Price
  onlinePrice Float      // Swiggy/Zomato Price
  cost        Float      // Raw Material COGS
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  saleLines   SaleLine[]
}

model Sale {
  id          String     @id // e.g. "slb-xxxx"
  date        DateTime   @default(now())
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id])
  channel     String     // counter | swiggy | zomato
  gross       Float
  discount    Float      @default(0.0)
  net         Float
  cogs        Float
  commission  Float      @default(0.0)
  packaging   Float      @default(0.0)
  profit      Float
  payment     String     // cash | upi | card | online
  orderType   String?    // dinein | takeaway
  isEdited    Boolean    @default(false)
  originalNet Float?
  editedAt    DateTime?
  lines       SaleLine[]
}

model SaleLine {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId    String?
  item      DishItem? @relation(fields: [itemId], references: [id])
  name      String
  qty       Int
  price     Float
  cost      Float
}

model StockItem {
  id           String      @id @default(cuid())
  name         String
  unit         String      // kg | L | pcs
  qty          Float       @default(0.0)
  reorderLevel Float
  costPerUnit  Float
  moves        StockMove[]
}

model StockMove {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  type        String    // in | out | wastage
  qty         Float
  note        String?
}

model KitchenBatch {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  batchDate  DateTime @default(now())
  shift      String   // lunch | dinner
  platesCooked Int    @default(160)
  platesSold   Int    @default(0)
  isClosed     Boolean @default(false)
}
